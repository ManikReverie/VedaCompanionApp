<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VedaCompanionApp">

        <!-- Main Home Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Internship Domains -->
        <activity
            android:name=".DomainsActivity"
            android:exported="false"
            android:label="@string/title_domains" />

        <!-- Projects Listing -->
        <activity
            android:name=".ProjectsActivity"
            android:exported="false"
            android:label="@string/title_projects" />

        <!-- Project Detail & Bookmark Screen -->
        <activity
            android:name=".ProjectDetailActivity"
            android:exported="false"
            android:label="@string/title_project_detail" />

        <!-- FAQ Screen -->
        <activity
            android:name=".FaqActivity"
            android:exported="false"
            android:label="@string/title_faq" />

        <!-- Favorites & Bookmarks Screen -->
        <activity
            android:name=".FavoritesActivity"
            android:exported="false"
            android:label="@string/title_favorites" />

    </application>

</manifest>
